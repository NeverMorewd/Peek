<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Remove="Resources\Strings.zh-hans.resx" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Resources\Strings.zh-hans.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncNavigation.Avalonia" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Irihi.Lingua" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Pipboy.Avalonia.Fx" />
    <PackageReference Include="ProDataGrid" />
    <PackageReference Include="ReactiveUI.Avalonia" />
	<PackageReference Include="ReactiveUI.SourceGenerators" />
	<PackageReference Include="AsyncNavigation" />
	<PackageReference Include="Pipboy.Avalonia" />
	<PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peek.Core\Peek.Core.csproj" />
    <ProjectReference Include="..\Peek.Ipc\Peek.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\LoadingIndicator.axaml.cs">
      <DependentUpon>LoadingIndicator.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SplashWindow.axaml.cs">
      <DependentUpon>SplashWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ElementTrackView.axaml.cs">
      <DependentUpon>ElementTrackView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\WindowTrackView.axaml.cs">
      <DependentUpon>WindowTrackView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
