<UserControl
    x:Class="Peek.UI.Views.ElementTrackView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Peek.Core.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="{x:Type vm:ElementTrackViewModel}"
    mc:Ignorable="d">
    <DockPanel Grid.Column="1">
        <ToggleSwitch
            Content="Tracking"
            DockPanel.Dock="Top"
            IsChecked="{Binding ElementTracker.IsTracking}" />
        <Border>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="CURRENT ELEMENT" />
                <TextBlock
                    FontSize="13"
                    Text="{Binding ElementTracker.CurrentElement.Abstraction}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
