<UserControl
    x:Class="Peek.UI.Views.WindowTrackView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hier="clr-namespace:Avalonia.Controls.DataGridHierarchical;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="using:Peek.Core.ViewModels"
    x:DataType="vm:WindowTrackViewModel">

    <UserControl.Resources />

    <Grid
        Margin="8"
        ColumnDefinitions="*,Auto"
        ColumnSpacing="8"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="6">

        <WrapPanel
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">

            <Button
                Margin="0,0,4,4"
                Command="{Binding RefreshCommand}"
                Content="⟳ Refresh"
                ToolTip.Tip="Force full re-enumeration (F5)" />

            <!--  Live monitoring toggle  -->
            <ToggleButton
                Margin="0,0,12,4"
                IsChecked="{Binding IsLiveMonitoring}"
                ToolTip.Tip="Toggle real-time WinEvent monitoring">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource PipboyTextDimBrush}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource PipboySuccessBrush}"
                        IsVisible="{Binding IsLiveMonitoring}" />
                    <TextBlock VerticalAlignment="Center">
                        >
                    </TextBlock>
                </StackPanel>
            </ToggleButton>

            <!--  Filters  -->
            <CheckBox
                Margin="0,0,8,4"
                Content="Visible only"
                IsChecked="{Binding ShowOnlyVisible}" />
            <CheckBox
                Margin="0,0,8,4"
                Content="Hide tool wins"
                IsChecked="{Binding HideToolWindows}" />
            <CheckBox
                Margin="0,0,8,4"
                Content="Show children"
                IsChecked="{Binding ShowChildren}" />
            <CheckBox
                Margin="0,0,12,4"
                Content="Exclude self"
                IsChecked="{Binding ExcludeSelf}"
                ToolTip.Tip="Hide windows belonging to this process" />

            <!--  Search  -->
            <TextBox
                Width="200"
                Margin="0,0,4,4"
                PlaceholderText="🔍"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,0,0,4"
                Command="{Binding ClearSearchCommand}"
                Content="✕"
                IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                ToolTip.Tip="Clear search" />
        </WrapPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">

            <TextBlock Foreground="{DynamicResource PipboyTextDimBrush}" Text="{Binding TotalCount, StringFormat='Total: {0}'}" />
            <TextBlock Foreground="{DynamicResource PipboyTextDimBrush}" Text="{Binding FilteredCount, StringFormat='Shown: {0}'}" />

            <Border
                Margin="4,0,0,0"
                Padding="6,1"
                Background="{DynamicResource PipboyPrimaryBrush}"
                CornerRadius="3"
                IsVisible="{Binding IsRefreshing}">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource PipboyTextBrush}"
                    Text="Refreshing…" />
            </Border>

            <Border
                Margin="4,0,0,0"
                Padding="6,1"
                Background="{DynamicResource PipboyWarningBrush}"
                CornerRadius="3"
                IsVisible="{Binding !IsLiveMonitoring}">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource PipboyWarningBrush}"
                    Text="⏸ Paused" />
            </Border>
        </StackPanel>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="8,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{DynamicResource PipboySurfaceBrush}"
            CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource PipboyTextDimBrush}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="{Binding IsLiveMonitoring, StringFormat='{}{0}'}" />
            </StackPanel>
        </Border>

        <DataGrid
            Name="Tree"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            AutoGenerateColumns="False"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            Classes="hierarchical"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HierarchicalRowsEnabled="True"
            IsReadOnly="True"
            RowHeight="22"
            SelectedItem="{Binding SelectedWindow}"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            UseLogicalScrollable="True">

            <DataGrid.Columns>

                <!--  HWND — expand/collapse toggle lives here  -->
                <DataGridHierarchicalColumn
                    Width="110"
                    x:CompileBindings="False"
                    Binding="{Binding Item}"
                    Header="HWND">
                    <DataGridHierarchicalColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:WindowItemViewModel">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Consolas,Menlo,monospace"
                                Foreground="{DynamicResource PipboyPrimaryLightBrush}"
                                Text="{Binding HwndDisplay}" />
                        </DataTemplate>
                    </DataGridHierarchicalColumn.CellTemplate>
                </DataGridHierarchicalColumn>

                <!--  Title  -->
                <DataGridTemplateColumn Width="2.5*" Header="Title">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <TextBlock
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                Foreground="{DynamicResource PipboyTextBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding Title}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Class name  -->
                <DataGridTemplateColumn Width="1.5*" Header="Class">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <TextBlock
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                Foreground="{DynamicResource PipboyTextDimBrush}"
                                Opacity="0.75"
                                Text="{Binding ClassName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding ClassName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Process name + PID  -->
                <DataGridTemplateColumn Width="130" Header="Process">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <StackPanel
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                Orientation="Horizontal"
                                Spacing="3">
                                <TextBlock
                                    Foreground="{DynamicResource PipboyTextBrush}"
                                    Text="{Binding ProcessName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource PipboyTextDimBrush}"
                                    Text="{Binding ProcessId, StringFormat='({0})'}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="170" Header="Rect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <TextBlock
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                FontFamily="Consolas,Menlo,monospace"
                                FontSize="11"
                                Foreground="{DynamicResource PipboyTextDimBrush}"
                                Text="{Binding RectDisplay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="72" Header="State">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <StackPanel
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                Orientation="Horizontal"
                                Spacing="2">

                                <!--  V = Visible  -->
                                <Border
                                    Padding="3,0"
                                    Background="{DynamicResource PipboySuccessBrush}"
                                    CornerRadius="2"
                                    IsVisible="{Binding IsVisible}"
                                    ToolTip.Tip="Visible">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PipboyTextBrush}"
                                        Text="V" />
                                </Border>

                                <!--  E = Enabled  -->
                                <Border
                                    Padding="3,0"
                                    Background="{DynamicResource PipboyPrimaryBrush}"
                                    CornerRadius="2"
                                    IsVisible="{Binding IsEnabled}"
                                    ToolTip.Tip="Enabled">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource PipboyPrimaryLightBrush}"
                                        Text="E" />
                                </Border>

                                <!--  ↓ = Minimized  -->
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource PipboyTextDimBrush}"
                                    IsVisible="{Binding IsMinimized}"
                                    Text="↓"
                                    ToolTip.Tip="Minimized" />

                                <!--  ↑ = Maximized  -->
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource PipboyPrimaryLightBrush}"
                                    IsVisible="{Binding IsMaximized}"
                                    Text="↑"
                                    ToolTip.Tip="Maximized" />

                                <!--  T = Topmost  -->
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource PipboyWarningBrush}"
                                    IsVisible="{Binding IsTopmost}"
                                    Text="T"
                                    ToolTip.Tip="Topmost (WS_EX_TOPMOST)" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Style hex  -->
                <DataGridTemplateColumn Width="96" Header="Style">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <TextBlock
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                FontFamily="Consolas,Menlo,monospace"
                                FontSize="11"
                                Foreground="{DynamicResource PipboyTextDimBrush}"
                                Text="{Binding StyleHex}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  ExStyle hex  -->
                <DataGridTemplateColumn Width="96" Header="ExStyle">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="hier:HierarchicalNode">
                            <TextBlock
                                VerticalAlignment="Center"
                                x:DataType="vm:WindowItemViewModel"
                                DataContext="{Binding Item}"
                                FontFamily="Consolas,Menlo,monospace"
                                FontSize="11"
                                Foreground="{DynamicResource PipboyTextDimBrush}"
                                Text="{Binding ExStyleHex}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Border
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Padding="10,5"
            Background="{DynamicResource PipboySurfaceBrush}"
            BorderBrush="{DynamicResource PipboyBorderBrush}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding SelectedWindow, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid
                x:DataType="vm:WindowItemViewModel"
                ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,Auto"
                ColumnSpacing="6"
                DataContext="{Binding SelectedWindow}">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="HWND:" />
                <SelectableTextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas,Menlo,monospace"
                    Foreground="{DynamicResource PipboyPrimaryLightBrush}"
                    Text="{Binding HwndDisplay}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="Class:" />
                <SelectableTextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextBrush}"
                    Text="{Binding ClassName}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Grid.Column="4"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="PID:" />
                <SelectableTextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextBrush}"
                    Text="{Binding ProcessId}" />

                <TextBlock
                    Grid.Column="6"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextDimBrush}"
                    Text="Thread:" />
                <TextBlock
                    Grid.Column="7"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PipboyTextBrush}"
                    Text="{Binding ThreadId}" />
            </Grid>
        </Border>

    </Grid>
</UserControl>