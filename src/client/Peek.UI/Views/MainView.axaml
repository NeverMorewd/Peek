<UserControl
    x:Class="Peek.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:an="using:AsyncNavigation.Avalonia"
    xmlns:converters="using:Peek.UI.Converters"
    xmlns:views="Peek.UI.Views"
    xmlns:vm="using:Peek.Core.ViewModels"
    x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
    </UserControl.Resources>
    <Grid Margin="10" ColumnDefinitions="200,*">
        <StackPanel
            Grid.Column="0"
            Orientation="Vertical"
            Spacing="10">
            <ToggleButton
                Command="{Binding NavigationCommand}"
                CommandParameter="ElementTrackView"
                Content="ElementTrack"
                IsChecked="{Binding CurrentViewName, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter='ElementTrackView'}" />
            <ToggleButton
                Command="{Binding NavigationCommand}"
                CommandParameter="WindowTrackView"
                Content="WindowTrack"
                IsChecked="{Binding CurrentViewName, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter='WindowTrackView'}" />
        </StackPanel>
        <Border
            Grid.Column="0"
            Width="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PipboyPrimaryBrush}"
            BorderBrush="Transparent"
            BorderThickness="0" />
        <ContentControl Grid.Column="1" an:RegionManager.RegionName="MainRegion" />
    </Grid>

</UserControl>